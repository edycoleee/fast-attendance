# ============================================================
# PostgreSQL Database Configuration
# ============================================================
# PENTING: Ganti sesuai IP komputer yang menjalankan Docker
# 
# DOCKER_HOST_IP: IP untuk Docker binding (di mana Docker listen)
#   - 0.0.0.0 = listen di semua interface (recommended)
#   - 192.168.30.14 = listen hanya di IP ini
#   - 127.0.0.1 = listen hanya localhost
#
# POSTGRES_HOST: IP untuk backend connect ke database
#   - Raspberry Pi: 192.168.30.14
#   - Local development: localhost
#   - Remote server: IP server yang menjalankan Docker
# ============================================================
DOCKER_HOST_IP=0.0.0.0
POSTGRES_DB=attendance_db
POSTGRES_USER=sultan
POSTGRES_PASSWORD=Sulfat123#!
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================================
# Database URL (for SQLAlchemy)
# ============================================================
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ============================================================
# pgAdmin Configuration
# ============================================================
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
